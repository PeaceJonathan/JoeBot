# Copy this file to .env and fill in real values. Never commit .env.

# Required by SEC's fair-access policy: a real, identifying User-Agent.
# Format: "AppName/Version (contact-email)"
SEC_USER_AGENT="JoeBot/0.1 (your-email@example.com)"

# Optional fallback market data source (finnhub.io free tier).
FINNHUB_API_KEY=

# Phase 4: Reddit sentiment (create an app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="joebot/0.1 by u/your-username"
